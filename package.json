{
  "name": "syncforge-monorepo",
  "version": "1.0.0",
  "description": "SyncForge — Scalable Real-Time Collaborative Document Editor",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --prefix client",
    "start:server": "npm run start --prefix server",
    "test": "npm run test --prefix server",
    "test:e2e": "node server/src/scripts/e2eVerify.js",
    "test:load": "node server/src/scripts/loadTest.js",
    "seed": "npm run seed --prefix server",
    "clean": "npm run clean --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
