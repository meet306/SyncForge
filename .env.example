# SyncForge Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/syncforge
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_SECRET=syncforge_super_secure_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Collaboration & Persistence Engine
SNAPSHOT_UPDATE_THRESHOLD=50
SNAPSHOT_INTERVAL_MS=60000
PERSISTENCE_DEBOUNCE_MS=2000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Real SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="SyncForge <your_email@gmail.com>"
